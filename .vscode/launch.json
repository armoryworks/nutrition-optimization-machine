{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "coreclr",
      "request": "launch",
      "name": "Launch Nom.Api",
      "program": "${workspaceFolder}/nom-api/Nom.Api/bin/Debug/net9.0/${input:executableName}",
      "args": [],
      "cwd": "${workspaceFolder}/nom-api/Nom.Api",
      "preLaunchTask": "build-nom-api"
    }
  ],
  "inputs": [
    {
      "id": "executableName",
      "type": "promptString",
      "description": "Enter the Nom.Api executable name (e.g., Nom.Api.dll)"
    }
  ]
}
