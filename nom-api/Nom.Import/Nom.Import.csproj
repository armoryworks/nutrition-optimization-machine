<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

   <ItemGroup>
    <!-- Project reference to access the DbContext and data entities -->
    <ProjectReference Include="..\Nom.Data\Nom.Data.csproj" />
    <!-- Project reference to access orchestration services if needed in the future -->
    <ProjectReference Include="..\Nom.Orch\Nom.Orch.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Required packages for dependency injection, configuration, and logging -->
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.11" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.11" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="10.0.11" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
    <PackageReference Include="CsvHelper" Version="33.1.0" />
  </ItemGroup>

   <ItemGroup>
    <!-- Ensure appsettings files are copied to the output directory -->
    <None Update="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="appsettings.Development.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <!-- This new ItemGroup ensures the SQL scripts are included in the build output -->
  <ItemGroup>
  <Content Include="DataImportScripts\*.sql">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="DataImportScripts\**\*.sql">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

</Project>
