# ===============================================
# NOM Production Environment Configuration
# ===============================================
# Copy this file to .env and update with your production values

# ===============================================
# Database Configuration
# ===============================================
POSTGRES_DB=nom
POSTGRES_USER=nom
POSTGRES_PASSWORD=change_this_in_production
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# ===============================================
# JWT Configuration
# ===============================================
JWT_SECRET_KEY=change_this_super_secret_jwt_key_in_production_minimum_32_characters
JWT_ISSUER=NOMApi
JWT_AUDIENCE=NOMAngular
JWT_EXPIRATION_MINUTES=1440

# ===============================================
# Application Configuration
# ===============================================
ASPNETCORE_ENVIRONMENT=Production
API_PORT=8080
UI_PORT=80
ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# ===============================================
# Redis Configuration (Optional)
# ===============================================
REDIS_CONNECTION_STRING=redis:6379

# ===============================================
# Security Configuration
# ===============================================
ENABLE_HSTS=true
ENABLE_SECURITY_HEADERS=true
ENABLE_RATE_LIMITING=true

# ===============================================
# Feature Flags (Optional)
# ===============================================
ENABLE_AI_SUGGESTIONS=true
ENABLE_WEB_SCRAPING=true
ENABLE_MESSAGING=true
ENABLE_HOUSEHOLD_FEATURES=true

# ===============================================
# Email Configuration (Optional)
# ===============================================
# Leave SMTP_HOST empty to use console-logging NoOp sender (for development)
EMAIL_SMTP_HOST=
EMAIL_SMTP_PORT=587
EMAIL_SMTP_USER=
EMAIL_SMTP_PASSWORD=
EMAIL_FROM_ADDRESS=noreply@nom.local
EMAIL_FROM_NAME=NOM
EMAIL_USE_SSL=true
